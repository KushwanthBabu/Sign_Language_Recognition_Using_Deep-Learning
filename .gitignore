# ============================================================
#  Sign Language Recognition — .gitignore
# ============================================================

# Large Dataset Files
data/raw/
data/keypoints/
data/processed/

# Trained Model Files (large binaries)
# best_kp_model.h5 is tracked via Git LFS — do NOT ignore it
!src/best_kp_model.h5
src/final_kp_model/


# Uploaded Test Files
uploads/

# Python Cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual Environment
venv/
env/
.venv/

# Jupyter
.ipynb_checkpoints/

# OS Files
.DS_Store
Thumbs.db
desktop.ini

# IDE / Editor
.vscode/
.idea/

# Temp / Logs
*.log
